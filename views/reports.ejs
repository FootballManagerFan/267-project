<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reports • Registration System</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/main.js" defer></script>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <main class="container">
      <header class="page-header">
        <div>
          <p class="eyebrow">Insights</p>
          <h1>Reports</h1>
        </div>
        <p class="page-description">
          Drill into enrollment trends, seat availability, departmental statistics, and more.
        </p>
      </header>
      <%- include('partials/messages') %>

      <div class="panel-grid">
        <section class="panel">
          <h2>Available Courses</h2>
          <div class="table-wrapper small">
            <table>
              <thead>
                <tr>
                  <th>Course</th>
                  <th>Term</th>
                  <th>Capacity</th>
                  <th>Available</th>
                </tr>
              </thead>
              <tbody>
                <% if (availableCourses.length) { %>
                  <% availableCourses.forEach((course) => { %>
                    <tr>
                      <td>
                        <strong><%= course.courseName %></strong>
                        <small><%= course.semester %> <%= course.year %></small>
                      </td>
                      <td><%= course.semester %> <%= course.year %></td>
                      <td><%= course.capacity %></td>
                      <td class="<%= course.seats_available <= 5 ? 'warning' : '' %>">
                        <%= course.seats_available %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4">No data.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <h2>Enrollment By Course</h2>
          <div class="table-wrapper small">
            <table>
              <thead>
                <tr>
                  <th>Course</th>
                  <th>Total Enrollments</th>
                  <th>Unique Students</th>
                </tr>
              </thead>
              <tbody>
                <% if (studentsPerCourse.length) { %>
                  <% studentsPerCourse.forEach((row) => { %>
                    <tr>
                      <td><%= row.courseName %></td>
                      <td><%= row.total_students %></td>
                      <td><%= row.unique_students %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="3">No data.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <section class="panel">
        <header class="panel-header">
          <h2>Student Enrollment Patterns</h2>
        </header>
        <div class="table-wrapper small">
          <table>
            <thead>
              <tr>
                <th>Student</th>
                <th>Total Enrollments</th>
                <th>Terms</th>
              </tr>
            </thead>
            <tbody>
              <% if (enrollmentPatterns.length) { %>
                <% enrollmentPatterns.forEach((row) => { %>
                  <tr>
                    <td><%= row.student_name %></td>
                    <td><%= row.total_enrollments %></td>
                    <td><%= row.terms || '—' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="3">No data.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <header class="panel-header">
          <h2>Department Statistics</h2>
        </header>
        <div class="table-wrapper small">
          <table>
            <thead>
              <tr>
                <th>Department</th>
                <th>Courses</th>
                <th>Professors</th>
                <th>Students</th>
              </tr>
            </thead>
            <tbody>
              <% if (departmentStats.length) { %>
                <% departmentStats.forEach((dept) => { %>
                  <tr>
                    <td><%= dept.deptName %></td>
                    <td><%= dept.total_courses %></td>
                    <td><%= dept.total_professors %></td>
                    <td><%= dept.total_students %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="4">No data.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <div class="panel-grid">
        <section class="panel">
          <h2>Run Custom Query</h2>
          <form action="/reports/query" method="post" class="form-grid single">
            <label>
              SQL (SELECT only)
              <textarea name="sql" rows="6" placeholder="SELECT * FROM Student LIMIT 10" required></textarea>
            </label>
            <button type="submit" class="btn primary">Execute</button>
          </form>
          <% if (customResults) { %>
            <div class="table-wrapper small mt-2">
              <table>
                <thead>
                  <tr>
                    <% customResults.columns.forEach((col) => { %>
                      <th><%= col %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% if (customResults.rows.length) { %>
                    <% customResults.rows.forEach((row) => { %>
                      <tr>
                        <% customResults.columns.forEach((col) => { %>
                          <td><%= row[col] %></td>
                        <% }) %>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="<%= customResults.columns.length || 1 %>">No rows returned.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>

        <section class="panel">
          <h2>Manage Views</h2>
          <form action="/reports/views/create" method="post" class="form-grid single">
            <label>
              View Name
              <input type="text" name="view_name" placeholder="active_courses_view" required />
            </label>
            <label>
              Definition
              <textarea
                name="view_definition"
                rows="4"
                placeholder="SELECT courseID, courseName FROM Course WHERE credits >= 3"
                required
              ></textarea>
            </label>
            <button type="submit" class="btn">Create / Replace</button>
          </form>

          <div class="table-wrapper tiny">
            <table>
              <thead>
                <tr>
                  <th>View</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (dbViews.length) { %>
                  <% dbViews.forEach((view) => { %>
                    <tr>
                      <td><%= view.name %></td>
                      <td>
                        <form
                          action="/reports/views/delete/<%= view.name %>"
                          method="post"
                          onsubmit="return confirmDelete('Delete this view?')"
                        >
                          <button type="submit" class="btn danger ghost">Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="2">No views defined.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <section class="panel">
        <header class="panel-header">
          <h2>Snapshots</h2>
          <p>Capture point-in-time data for auditing.</p>
        </header>
        <form action="/reports/snapshots/create" method="post" class="form-grid inline-form">
          <label>
            Snapshot Name
            <input type="text" name="snapshot_name" placeholder="Fall 2025 Census" />
          </label>
          <button type="submit" class="btn primary">Create Snapshot</button>
        </form>
        <div class="table-wrapper small">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Created</th>
                <th>Payload</th>
              </tr>
            </thead>
            <tbody>
              <% if (snapshots.length) { %>
                <% snapshots.forEach((snapshot) => { %>
                  <tr>
                    <td><%= snapshot.snapshot_name %></td>
                    <td><%= new Date(snapshot.created_at).toLocaleString() %></td>
                    <td><pre><code><%= JSON.stringify(snapshot.payload, null, 2) %></code></pre></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="3">No snapshots captured.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </body>
</html>

