-- Views (for reporting and front-end)

-- View: Course enrollment summary
CREATE OR REPLACE VIEW vwCourseEnrollmentSummary AS
SELECT
  c.courseID,
  c.courseName,
  d.deptName AS department,
  COUNT(e.enrollmentID) AS totalEnrollments,
  COALESCE(SUM(co.capacity), 0) AS totalCapacity
FROM Course c
JOIN Department d ON c.departmentID = d.departmentID
LEFT JOIN CourseOffering co ON co.courseID = c.courseID
LEFT JOIN Enrollment e ON e.offeringID = co.offeringID
GROUP BY c.courseID, c.courseName, d.deptName;

-- View: Student schedule (flat)
CREATE OR REPLACE VIEW vwStudentSchedule AS
SELECT
  s.studentID,
  s.firstName AS studentFirstName,
  s.lastName  AS studentLastName,
  c.courseName,
  co.semester,
  co.year,
  co.roomNumber,
  co.scheduleTime,
  e.status,
  e.grade
FROM Student s
JOIN Enrollment e      ON e.studentID = s.studentID
JOIN CourseOffering co ON co.offeringID = e.offeringID
JOIN Course c          ON c.courseID = co.courseID;

